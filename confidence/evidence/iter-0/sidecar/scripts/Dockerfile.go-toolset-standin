# Sandbox stand-in for registry.access.redhat.com/ubi9/go-toolset:1.24 (that registry is blocked here):
# the same Go minor on Debian, with the UBI CA bundle path the sidecar Dockerfile copies from.
FROM golang:1.24
RUN mkdir -p /etc/pki/ca-trust/extracted/pem /opt/app-root/src \
 && cp /etc/ssl/certs/ca-certificates.crt /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
 && chown 1001:0 /opt/app-root/src
